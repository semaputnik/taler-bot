# Copy to .env in this directory and fill in the secrets. Environment variables override it.
# Use a dev bot, never the Casa Receipts / Casa Mail tokens.
# The server uses .env.prod.template instead (see docs/deploy.md).
BOT__TOKEN=

# CRITICAL, ERROR, WARNING, INFO or DEBUG
LOG_LEVEL=INFO

# Minutes without a tap before a command screen is deleted; 0 turns expiry off
SCREEN_TTL_MINUTES=30
# How often the bot looks for expired screens, in seconds (at least 1)
SCREEN_SWEEP_SECONDS=30

DATABASE__URL=postgresql+asyncpg://taler:taler@localhost:5447/taler
REDIS__URL=redis://localhost:6390/0

LLM__API_KEY=
LLM__MODEL=openai:gpt-6-luna
LLM__TIMEOUT_S=120

STORAGE__RECEIPTS_DIR=data/receipts
