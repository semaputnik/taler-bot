# Production settings. On the server copy this to `.env` next to docker-compose.prod.yml.
# Compose reads it twice: to fill ${...} in the compose file, and as the bot's environment.
# Use the production bot's token here; development uses its own bot (see docs/deploy.md).
BOT__TOKEN=

LLM__API_KEY=
LLM__MODEL=openai:gpt-6-luna
LLM__TIMEOUT_S=120

# CRITICAL, ERROR, WARNING, INFO or DEBUG
LOG_LEVEL=INFO

# Letters and digits only, so that the database URL needs no escaping.
POSTGRES_PASSWORD=

# Absolute path; holds postgres/, redis/ and receipts/ (a backup is a copy of it).
DATA_DIR=/srv/taler-bot

# Image tag: latest, or sha-<short commit> to pin a release or roll back.
TALER_TAG=latest

# Set by docker-compose.prod.yml, not here: compose does not interpolate ${POSTGRES_PASSWORD}
# inside env_file values, so the file passes these through `environment:` instead.
#   DATABASE__URL=postgresql+asyncpg://taler:<POSTGRES_PASSWORD>@postgres:5432/taler
#   REDIS__URL=redis://redis:6379/0
#   STORAGE__RECEIPTS_DIR=/data/receipts
